# Port the Express API bridge listens on
PORT=3001

# --- OpenAI (primary LLM - direct API, not via Kie.ai) ---
# gpt-5.6-terra requires reasoning_effort:"none" when tools are attached (enforced
# in openAiService.js) and max_completion_tokens instead of the legacy max_tokens.
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-terra

# --- Kie.ai (currently unused - account-wide model access blocked as of 2026-08-23) ---
# Kept for when Kie.ai access is fixed; see scripts/verify-kie-claude.js.
KIE_AI_API_KEY=your_kie_ai_key
KIE_CLAUDE_MODEL=claude-opus-5

# --- Pinecone (vector store for RAG retrieval) ---
# This index uses Pinecone's integrated inference (a hosted embedding model,
# e.g. llama-text-embed-v2, bound to the index itself) - Pinecone embeds
# query text server-side, so no separate embeddings provider is needed.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_pinecone_index_name

# Comma-separated list of origins allowed to call this API (no spaces needed, they are trimmed).
# Browsers attach an Origin header to POST requests even when same-origin, so include this
# server's own "http://localhost:<PORT>" too if you'll test via the bundled public/index.html.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:3001

# --- File attachments (POST /api/chat/upload) ---
# Max upload size in bytes (default 10MB) and max characters of extracted
# text folded into the model's context per attachment (a character-based
# heuristic, not a token-exact budget - see parseAttachment.js).
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENT_CHARS=12000
